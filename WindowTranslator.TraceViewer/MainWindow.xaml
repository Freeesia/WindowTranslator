<Window x:Class="WindowTranslator.TraceViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WindowTranslator.TraceViewer"
        Title="OCR トレースビューア" Width="1200" Height="760"
        MinWidth="800" MinHeight="520" FontFamily="Yu Gothic UI">
    <Grid x:Name="Root" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <DockPanel>
                <Button Content="JSONL を開く…" Padding="12,6" Click="Open_Click" />
                <ComboBox x:Name="ModeSelector" DockPanel.Dock="Right" Width="130" Margin="12,0,0,0"
                          SelectedIndex="2" SelectionChanged="DisplayMode_Changed">
                    <ComboBoxItem Content="Raw OCR" />
                    <ComboBoxItem Content="Tracked" />
                    <ComboBoxItem Content="左右比較" />
                    <ComboBoxItem Content="重ね合わせ" />
                </ComboBox>
                <TextBlock x:Name="FileText" Margin="12,0" VerticalAlignment="Center"
                           Text="JSON Lines 形式の OCR トレースを開いてください。" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <TextBlock x:Name="ErrorText" Foreground="DarkRed" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,8,0,12">
            <StackPanel Width="220" Margin="0,0,20,0">
                <TextBlock Text="位置・サイズの安定性（1～5）" />
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Width="24" TextAlignment="Right"
                               Text="{Binding Value, ElementName=GeometrySlider, StringFormat={}{0:0}}" />
                    <Slider x:Name="GeometrySlider" Minimum="1" Maximum="5" TickFrequency="1"
                            IsSnapToTickEnabled="True" ValueChanged="TrackerSettings_Changed" />
                </DockPanel>
            </StackPanel>
            <StackPanel Width="220" Margin="0,0,20,0">
                <TextBlock Text="文字列・構造の安定性（1～5）" />
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Width="24" TextAlignment="Right"
                               Text="{Binding Value, ElementName=RecognitionSlider, StringFormat={}{0:0}}" />
                    <Slider x:Name="RecognitionSlider" Minimum="1" Maximum="5" TickFrequency="1"
                            IsSnapToTickEnabled="True" ValueChanged="TrackerSettings_Changed" />
                </DockPanel>
            </StackPanel>
            <StackPanel Width="220">
                <TextBlock Text="OCR 欠落の保持回数（0～7）" />
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Width="24" TextAlignment="Right"
                               Text="{Binding Value, ElementName=RetentionSlider, StringFormat={}{0:0}}" />
                    <Slider x:Name="RetentionSlider" Minimum="0" Maximum="7" TickFrequency="1"
                            IsSnapToTickEnabled="True" ValueChanged="TrackerSettings_Changed" />
                </DockPanel>
            </StackPanel>
        </WrapPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="RawColumn" Width="*" />
                <ColumnDefinition x:Name="TrackedColumn" Width="*" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="RawPanel" Margin="0,0,6,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="RawLabel" Text="Raw OCR" FontWeight="SemiBold" Margin="0,0,0,6" />
                <local:OcrDrawingSurface x:Name="RawSurface" Grid.Row="1" />
            </Grid>
            <Grid x:Name="TrackedPanel" Grid.Column="1" Margin="6,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Tracked" FontWeight="SemiBold" Margin="0,0,0,6" />
                <local:OcrDrawingSurface x:Name="TrackedSurface" Grid.Row="1" />
            </Grid>
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <Slider x:Name="SeekSlider" Minimum="0" Maximum="0" TickFrequency="1"
                    IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" IsEnabled="False"
                    ValueChanged="Seek_Changed" />
            <DockPanel Margin="0,8,0,0" LastChildFill="False">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="PreviousButton" Content="前フレーム" Padding="10,6" Margin="0,0,8,0"
                            IsEnabled="False" Click="Previous_Click" />
                    <Button x:Name="PlayButton" Content="再生" Width="90" Padding="10,6" Margin="0,0,8,0"
                            IsEnabled="False" Click="Play_Click" />
                    <Button x:Name="NextButton" Content="次フレーム" Padding="10,6" IsEnabled="False" Click="Next_Click" />
                </StackPanel>
            </DockPanel>
            <TextBlock x:Name="FrameText" Text="フレーム 0 / 0" Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
