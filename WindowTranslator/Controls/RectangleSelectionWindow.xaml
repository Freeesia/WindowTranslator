<Window
    x:Class="WindowTranslator.Controls.RectangleSelectionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:properties="clr-namespace:WindowTranslator.Properties"
    Title="{x:Static properties:Resources.PriorityRectSelection}"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStyle="None">
    <Canvas
        x:Name="SelectionCanvas"
        Background="#40000000"
        Cursor="Cross"
        MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
        MouseLeftButtonUp="Canvas_MouseLeftButtonUp"
        MouseMove="Canvas_MouseMove">
        <Rectangle
            x:Name="SelectionRect"
            Fill="#3000A0FF"
            Stroke="Red"
            StrokeDashArray="4 2"
            StrokeThickness="2"
            Visibility="Collapsed" />
        <Border
            Canvas.Left="10"
            Canvas.Top="10"
            Padding="8,4"
            Background="#C0000000"
            CornerRadius="4">
            <TextBlock
                x:Name="InfoText"
                Foreground="White"
                Text="{x:Static properties:Resources.PriorityRectSelectionGuide}" />
        </Border>
    </Canvas>
</Window>
