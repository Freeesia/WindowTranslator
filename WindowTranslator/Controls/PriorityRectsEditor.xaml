<UserControl
    x:Class="WindowTranslator.Controls.PriorityRectsEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dd="urn:gong-wpf-dragdrop"
    xmlns:local="clr-namespace:WindowTranslator.Controls"
    xmlns:properties="clr-namespace:WindowTranslator.Properties"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel>
        <ui:ListView
            x:Name="RectList"
            MaxHeight="120"
            dd:DragDrop.IsDragSource="True"
            dd:DragDrop.IsDropTarget="True"
            SelectionChanged="RectList_SelectionChanged">
            <ui:ListView.ItemTemplate>
                <DataTemplate>
                    <DockPanel>
                        <ui:Button
                            Click="RemoveButton_Click"
                            DockPanel.Dock="Right"
                            Icon="{ui:SymbolIcon Delete24}" />
                        <ContentPresenter
                            Margin="4,0"
                            VerticalAlignment="Center"
                            Content="{Binding DisplayText}" />
                    </DockPanel>
                </DataTemplate>
            </ui:ListView.ItemTemplate>
        </ui:ListView>

        <ui:Button
            x:Name="AddButton"
            Margin="0,0,0,4"
            HorizontalAlignment="Stretch"
            Click="AddButton_Click"
            Content="{x:Static properties:Resources.PriorityRectAdd}"
            Icon="{ui:SymbolIcon Add24}" />

        <DockPanel Margin="0,8,0,0">
            <TextBlock
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Text="{x:Static properties:Resources.PriorityRectKeyword}" />
            <ui:TextBox
                x:Name="KeywordBox"
                DataContext="{Binding SelectedItem, ElementName=RectList}"
                IsEnabled="{Binding SelectedItem, ElementName=RectList, Converter={x:Static local:NotNullToBooleanConverter.Default}}"
                PlaceholderText="{x:Static properties:Resources.PriorityRectKeywordDescription}"
                Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>
    </StackPanel>
</UserControl>
