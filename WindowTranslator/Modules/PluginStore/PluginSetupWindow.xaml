<ui:FluentWindow
    x:Class="WindowTranslator.Modules.PluginStore.PluginSetupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:WindowTranslator.Controls"
    xmlns:md="https://github.com/whistyun/MdXaml"
    xmlns:mdp="clr-namespace:MdXaml.Plugins;assembly=MdXaml.Plugins"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{Binding [SetupTitle]}"
    Width="720"
    Height="640"
    MinWidth="480"
    MinHeight="400"
    ExtendsContentIntoTitleBar="True"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen">
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="b2v" />
            <Style
                x:Key="setupMarkdownStyle"
                BasedOn="{x:Static md:MarkdownStyle.GithubLike}"
                TargetType="FlowDocument">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar
            Title="WindowTranslator"
            Icon="{ui:ImageIcon '/WindowTranslator;component/wt.ico'}"
            ShowClose="True"
            ShowMaximize="False"
            ShowMinimize="False" />
        <Grid Grid.Row="1" Margin="24,8,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,20">
                <TextBlock Margin="0,0,0,8" FontSize="24" FontWeight="SemiBold" Text="{Binding [SetupTitle]}" />
                <TextBlock Text="{Binding [SetupDescription]}" TextWrapping="Wrap" />
            </StackPanel>
            <ScrollViewer
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,8">
                                <StackPanel Margin="0,4,0,8" Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="{Binding Name}" />
                                    <ItemsControl ItemsSource="{Binding HelpLinks}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ui:HyperlinkButton
                                                    Margin="6,0,0,0"
                                                    Padding="4"
                                                    CornerRadius="16"
                                                    NavigateUri="{Binding Uri}"
                                                    ToolTip="{Binding ToolTip}">
                                                    <ui:SymbolIcon
                                                        Filled="True"
                                                        FontSize="24"
                                                        Foreground="DodgerBlue"
                                                        Symbol="QuestionCircle48" />
                                                </ui:HyperlinkButton>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Packages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="4,0,12,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox
                                                        Margin="0,0,4,0"
                                                        VerticalAlignment="Top"
                                                        AutomationProperties.Name="{Binding Package.Title}"
                                                        IsChecked="{Binding IsSelected}"
                                                        IsEnabled="{Binding DataContext.CanSelect, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}" />
                                                    <Expander
                                                        Grid.Column="1"
                                                        Header="{Binding Package.Title}"
                                                        IsExpanded="{Binding IsExpanded}">
                                                        <StackPanel Margin="0,4,0,4">
                                                            <ui:ProgressRing
                                                                Width="20"
                                                                Height="20"
                                                                HorizontalAlignment="Left"
                                                                IsIndeterminate="True"
                                                                Visibility="{Binding Package.IsReadmeLoading, Converter={StaticResource b2v}}" />
                                                            <md:MarkdownScrollViewer
                                                                MaxHeight="240"
                                                                Margin="0,4,0,0"
                                                                ClickAction="OpenBrowser"
                                                                Markdown="{Binding Package.ReadmeMarkdown}"
                                                                MarkdownStyle="{StaticResource setupMarkdownStyle}"
                                                                Visibility="{Binding Package.HasReadme, Converter={StaticResource b2v}}">
                                                                <md:MarkdownScrollViewer.Plugins>
                                                                    <mdp:MdXamlPlugins>
                                                                        <ctrl:CustomPluginSetup />
                                                                    </mdp:MdXamlPlugins>
                                                                </md:MarkdownScrollViewer.Plugins>
                                                            </md:MarkdownScrollViewer>
                                                        </StackPanel>
                                                    </Expander>
                                                </Grid>
                                                <TextBlock
                                                    Margin="28,4,0,0"
                                                    Text="{Binding ErrorMessage}"
                                                    TextWrapping="Wrap"
                                                    Visibility="{Binding HasError, Converter={StaticResource b2v}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Margin="0,8,0,0">
                <ProgressBar
                    Height="4"
                    Margin="0,0,0,8"
                    IsIndeterminate="{Binding IsLoading}"
                    Value="{Binding InstallProgress}"
                    Visibility="{Binding IsProgressVisible, Converter={StaticResource b2v}}" />
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                <ui:Button
                    Margin="0,8,0,0"
                    HorizontalAlignment="Left"
                    Command="{Binding ReloadCommand}"
                    Content="{Binding [SetupRetry]}"
                    Visibility="{Binding HasSearchError, Converter={StaticResource b2v}}" />
            </StackPanel>
            <StackPanel Grid.Row="3" Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                <ui:Button
                    MinWidth="120"
                    Margin="0,0,12,0"
                    Appearance="Primary"
                    Command="{Binding InstallCommand}"
                    Content="{Binding PrimaryText}" />
                <ui:Button
                    MinWidth="120"
                    Command="{Binding FinishCommand}"
                    Content="{Binding SecondaryText}" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
