<ui:FluentWindow
    x:Class="WindowTranslator.Modules.PluginStore.PluginSetupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:properties="clr-namespace:WindowTranslator.Properties"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{Binding [SetupTitle]}"
    Width="720"
    Height="640"
    MinWidth="480"
    MinHeight="400"
    ExtendsContentIntoTitleBar="True"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="b2v" />
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar
            Title="WindowTranslator"
            Icon="{ui:ImageIcon '/WindowTranslator;component/wt.ico'}"
            ShowClose="False"
            ShowMaximize="False" />
        <Grid Grid.Row="1" Margin="24,8,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,20">
                <TextBlock Margin="0,0,0,8" FontSize="24" FontWeight="SemiBold" Text="{Binding [SetupTitle]}" />
                <TextBlock Text="{Binding [SetupDescription]}" TextWrapping="Wrap" />
            </StackPanel>
            <ProgressBar
                Grid.Row="1"
                Height="4"
                Margin="0,0,0,8"
                IsIndeterminate="True"
                Visibility="{Binding IsLoading, Converter={StaticResource b2v}}" />
            <ScrollViewer
                Grid.Row="2"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock
                                    Margin="0,4,0,8"
                                    FontWeight="SemiBold"
                                    Text="{Binding Name}" />
                                <ItemsControl ItemsSource="{Binding Packages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="4,0,12,12">
                                                <CheckBox
                                                    Content="{Binding Package.Title}"
                                                    IsChecked="{Binding IsSelected}"
                                                    IsEnabled="{Binding DataContext.CanSelect, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}" />
                                                <TextBlock
                                                    Margin="28,2,0,4"
                                                    Opacity="0.75"
                                                    Text="{Binding Package.Description}"
                                                    TextWrapping="Wrap" />
                                                <StackPanel Margin="28,0,0,0" Orientation="Horizontal">
                                                    <CheckBox
                                                        Content="{x:Static properties:Resources.Prerelease}"
                                                        IsChecked="{Binding Package.UsePrerelease}"
                                                        IsEnabled="{Binding DataContext.CanSelect, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                                        Visibility="{Binding Package.HasPrereleaseVersion, Converter={StaticResource b2v}}" />
                                                    <TextBlock Margin="8,0,0,0" Text="{Binding Package.LatestVersion}" />
                                                    <TextBlock
                                                        Margin="8,0,0,0"
                                                        Text="{x:Static properties:Resources.Installed}"
                                                        Visibility="{Binding Package.IsInstalled, Converter={StaticResource b2v}}" />
                                                </StackPanel>
                                                <ProgressBar
                                                    Height="4"
                                                    Margin="28,4,0,0"
                                                    Value="{Binding Package.InstallProgress}"
                                                    Visibility="{Binding Package.IsInstalling, Converter={StaticResource b2v}}" />
                                                <TextBlock
                                                    Margin="28,4,0,0"
                                                    Text="{Binding ErrorMessage}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <StackPanel Grid.Row="3" Margin="0,8,0,0">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                <ui:Button
                    Margin="0,8,0,0"
                    HorizontalAlignment="Left"
                    Command="{Binding ReloadCommand}"
                    Content="{Binding [SetupRetry]}"
                    Visibility="{Binding HasSearchError, Converter={StaticResource b2v}}" />
            </StackPanel>
            <StackPanel Grid.Row="4" Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                <ui:Button
                    MinWidth="120"
                    Margin="0,0,12,0"
                    Appearance="Primary"
                    Command="{Binding InstallCommand}"
                    Content="{Binding PrimaryText}" />
                <ui:Button
                    MinWidth="120"
                    Command="{Binding FinishCommand}"
                    Content="{Binding SecondaryText}" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
