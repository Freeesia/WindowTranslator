<ui:FluentWindow
    x:Class="WindowTranslator.Modules.Settings.AllSettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:data="clr-namespace:WindowTranslator.Data"
    xmlns:local="clr-namespace:WindowTranslator.Modules.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pluginStore="clr-namespace:WindowTranslator.Modules.PluginStore"
    xmlns:properties="clr-namespace:WindowTranslator.Properties"
    xmlns:pt="http://propertytools.org/wpf"
    xmlns:root="clr-namespace:WindowTranslator"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{Binding Title, Source={x:Static root:AppInfo.Instance}}"
    Width="800"
    Height="720"
    d:DataContext="{d:DesignInstance {x:Type local:AllSettingsViewModel}}"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Default"
    mc:Ignorable="d">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="b2vConv" />
        <Style BasedOn="{StaticResource {x:Type GroupBox}}" TargetType="{x:Type GroupBox}">
            <Setter Property="Margin" Value="4" />
        </Style>
        <Style BasedOn="{StaticResource {x:Type Label}}" TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8" />
        </Style>
        <local:SettingsPropertyGridFactory x:Key="factory" />
        <local:SettingsPropertyGridOperator x:Key="operator" />
        <Style BasedOn="{StaticResource {x:Type TabItem}}" TargetType="TabItem">
            <Setter Property="Background" Value="{ui:ThemeResource SubtleFillColorTertiaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Grid x:Name="Root">
                            <Border
                                x:Name="Border"
                                MinWidth="180"
                                MinHeight="36"
                                Margin="0"
                                Padding="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="8,8,0,0">
                                <ContentPresenter
                                    x:Name="ContentSite"
                                    Margin="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    ContentSource="Header"
                                    RecognizesAccessKey="True" />
                            </Border>
                            <Rectangle
                                x:Name="ActiveRectangle"
                                Height="3"
                                Margin="8,0,8,2"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Bottom"
                                Fill="{DynamicResource TreeViewItemSelectionIndicatorForeground}"
                                RadiusX="2"
                                RadiusY="2"
                                Visibility="Collapsed" />

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="SelectionStates">
                                    <VisualState x:Name="Unselected" />
                                    <VisualState x:Name="Selected" />

                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="MouseOver" />
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="Border"
                                                Storyboard.TargetProperty="(Panel.Background).(SolidColorBrush.Opacity)"
                                                From="0.0"
                                                To="0.5"
                                                Duration="0:0:.16" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Panel.ZIndex" Value="100" />
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource TabViewItemHeaderBackgroundSelected}" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource TabViewSelectedItemBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TabViewItemForegroundSelected}" />
                                <Setter TargetName="ActiveRectangle" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>
    <Grid>
        <DockPanel>
            <ui:TitleBar
                Title="{Binding Title, Source={x:Static root:AppInfo.Instance}}"
                DockPanel.Dock="Top"
                ShowMinimize="False">
                <ui:TitleBar.Icon>
                    <ui:ImageIcon Source="/wt.ico" />
                </ui:TitleBar.Icon>
                <ui:TitleBar.TrailingContent>
                    <StackPanel Orientation="Horizontal">
                        <ui:DropDownButton
                            Width="44"
                            Height="30"
                            VerticalAlignment="Top"
                            VerticalContentAlignment="Stretch"
                            Background="Goldenrod"
                            BorderThickness="0"
                            CornerRadius="0"
                            Icon="{ui:SymbolIcon MegaphoneLoud32}"
                            MouseOverBackground="Gold"
                            Style="{StaticResource DefaultUiButtonStyle}"
                            Visibility="{Binding HasUpdate, Converter={StaticResource b2vConv}}">
                            <ui:DropDownButton.ToolTip>
                                <ui:TextBlock Text="{Binding NewVersion, StringFormat={x:Static properties:Resources.NewVersionAvailable}}" />
                            </ui:DropDownButton.ToolTip>
                            <ui:DropDownButton.Flyout>
                                <ContextMenu>
                                    <ui:MenuItem Command="{Binding InstallUpdateCommand}">
                                        <ui:MenuItem.Header>
                                            <ui:TextBlock Text="{Binding NewVersion, StringFormat={x:Static properties:Resources.InstallNewVersion}}" />
                                        </ui:MenuItem.Header>
                                        <ui:MenuItem.Icon>
                                            <ui:SymbolIcon
                                                Filled="True"
                                                Foreground="LawnGreen"
                                                Symbol="PresenceAvailable24" />
                                        </ui:MenuItem.Icon>
                                    </ui:MenuItem>
                                    <ui:MenuItem
                                        Command="{Binding OpenReleaseNotesCommand}"
                                        Header="{x:Static properties:Resources.CheckUpdateNotes}"
                                        Icon="{ui:SymbolIcon Globe24}" />
                                </ContextMenu>
                            </ui:DropDownButton.Flyout>
                        </ui:DropDownButton>
                        <ui:Button
                            Width="44"
                            Height="30"
                            VerticalAlignment="Top"
                            VerticalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding CheckUpdateCommand}"
                            CornerRadius="0"
                            Icon="{ui:SymbolIcon ArrowSync24}"
                            ToolTip="{x:Static properties:Resources.CheckNewVersion}"
                            Visibility="{Binding HasUpdate, Mode=OneWay, Converter={x:Static local:FalseToVisibilityConverter.Default}}" />
                    </StackPanel>
                </ui:TitleBar.TrailingContent>
            </ui:TitleBar>
            <ProgressBar
                Height="4"
                DockPanel.Dock="Top"
                IsIndeterminate="{Binding IsBusy, Mode=OneWay}" />
            <DockPanel Margin="4" DockPanel.Dock="Bottom">
                <DockPanel.Resources>
                    <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="{x:Type ui:Button}">
                        <Setter Property="Margin" Value="4" />
                        <Setter Property="Width" Value="120" />
                    </Style>
                </DockPanel.Resources>

                <ui:Button DockPanel.Dock="Right" IsCancel="True">
                    <ui:Button.Style>
                        <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                            <Setter Property="Content" Value="{x:Static properties:Resources.Cancel}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ApplyMode, Mode=OneTime}" Value="True">
                                    <Setter Property="Content" Value="{x:Static properties:Resources.Close}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
                <ui:Button
                    Command="{Binding SaveCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                    DockPanel.Dock="Right"
                    IsDefault="{Binding ApplyMode, Converter={x:Static data:InverseBoolConverter.Default}}">
                    <ui:Button.Style>
                        <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                            <Setter Property="Content" Value="{x:Static properties:Resources.OK}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ApplyMode, Mode=OneTime}" Value="True">
                                    <Setter Property="Content" Value="{x:Static properties:Resources.Apply}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
                <ui:Button
                    Command="{Binding PluginStore.RestartCommand}"
                    Content="{x:Static properties:Resources.Restart}"
                    DockPanel.Dock="Right"
                    Visibility="{Binding PluginStore.RequiresRestart, Converter={StaticResource b2vConv}}" />
                <ui:ToggleSwitch
                    Margin="4"
                    Content="{x:Static properties:Resources.AutoStartWithPC}"
                    IsChecked="{Binding IsStartup, Mode=TwoWay}" />
            </DockPanel>
            <TabControl SelectedIndex="{Binding SelectedTab}">
                <TabItem Header="{x:Static properties:Resources.GeneralSettings}" IsEnabled="{Binding TargetMode, Mode=OneTime, Converter={x:Static data:InverseBoolConverter.Default}}">
                    <TabItem.HeaderTemplate>
                        <DataTemplate>
                            <ui:TextBlock Text="{Binding}">
                                <ui:TextBlock.Style>
                                    <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="TextBlock">
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Foreground" Value="{DynamicResource TextControlForegroundDisabled}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:TextBlock.Style>
                            </ui:TextBlock>
                        </DataTemplate>
                    </TabItem.HeaderTemplate>
                    <DockPanel>
                        <GroupBox DockPanel.Dock="Top" Header="{x:Static properties:Resources.DisplayMethod}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Content="{x:Static properties:Resources.ViewMode}" />
                                <ComboBox
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    DisplayMemberPath="Display"
                                    ItemsSource="{Binding ViewModes}"
                                    SelectedValue="{Binding ViewMode}"
                                    SelectedValuePath="Value" />

                                <CheckBox
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Content="{x:Static properties:Resources.IsEnableCaptureOverlay}"
                                    IsChecked="{Binding IsEnableCaptureOverlay}"
                                    IsEnabled="{Binding IsCheckableCapture}" />

                                <Label
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Content="{x:Static properties:Resources.OverlaySwitch}" />
                                <ComboBox
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    DisplayMemberPath="Display"
                                    ItemsSource="{Binding OverlaySwitches}"
                                    SelectedValue="{Binding OverlaySwitch}"
                                    SelectedValuePath="Value" />


                                <CheckBox
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Content="{x:Static properties:Resources.IsOverlayPointSwap}"
                                    IsChecked="{Binding IsOverlayPointSwap}"
                                    IsEnabled="{Binding IsCheckableCapture}" />
                            </Grid>
                        </GroupBox>
                    </DockPanel>
                </TabItem>
                <TabItem Header="{x:Static properties:Resources.TargetSpecificSettings}">
                    <pt:PropertyGrid
                        Margin="8"
                        ControlFactory="{StaticResource factory}"
                        Operator="{StaticResource operator}"
                        SelectedObject="{Binding SelectedTarget}"
                        TabStripPlacement="Left">
                        <pt:PropertyGrid.TabHeaderTemplate>
                            <DataTemplate DataType="{x:Type pt:Tab}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image
                                        x:Name="Icon"
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,6,0"
                                        Source="{Binding Icon}" />
                                    <TextBlock
                                        x:Name="Header"
                                        Grid.Column="1"
                                        Text="{Binding Header}"
                                        TextWrapping="Wrap" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                        <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasWarnings}" Value="True">
                                        <Setter TargetName="Header" Property="Foreground" Value="Orange" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasErrors}" Value="True">
                                        <Setter TargetName="Header" Property="Foreground" Value="Red" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </pt:PropertyGrid.TabHeaderTemplate>
                        <pt:PropertyGrid.Resources>
                            <Style BasedOn="{StaticResource {x:Type TabControl}}" TargetType="TabControl">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TabControl">
                                            <Grid KeyboardNavigation.TabNavigation="Local">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="200" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    BorderBrush="{DynamicResource SeparatorBorderBrush}"
                                                    BorderThickness="0,0,1,0">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="*" />
                                                        </Grid.RowDefinitions>
                                                        <Grid
                                                            Margin="4,0,8,12"
                                                            DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                                            IsEnabled="{Binding TargetMode, Mode=OneTime, Converter={x:Static data:InverseBoolConverter.Default}}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <ComboBox
                                                                HorizontalContentAlignment="Stretch"
                                                                AutomationProperties.Name="{x:Static properties:Resources.TargetProcesses}"
                                                                ItemsSource="{Binding Targets}"
                                                                SelectedItem="{Binding SelectedTarget}">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate DataType="{x:Type local:TargetSettingsViewModel}">
                                                                        <TextBlock
                                                                            Text="{Binding Name, Converter={x:Static local:TargetNameConverter.Default}}"
                                                                            TextTrimming="CharacterEllipsis"
                                                                            ToolTip="{Binding Name, Converter={x:Static local:TargetNameConverter.Default}}" />
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                            <ui:Button
                                                                Grid.Column="1"
                                                                Margin="4,0,0,0"
                                                                Padding="6"
                                                                Command="{Binding DeleteTargetSettingCommand}"
                                                                CommandParameter="{Binding SelectedTarget}"
                                                                Content="{ui:SymbolIcon Delete24}" />
                                                        </Grid>
                                                        <ScrollViewer
                                                            Grid.Row="1"
                                                            Margin="0,0,8,0"
                                                            Focusable="False"
                                                            HorizontalScrollBarVisibility="Disabled"
                                                            VerticalScrollBarVisibility="Auto">
                                                            <TabPanel
                                                                x:Name="HeaderPanel"
                                                                IsItemsHost="True"
                                                                KeyboardNavigation.TabIndex="1" />
                                                        </ScrollViewer>
                                                    </Grid>
                                                </Border>
                                                <ContentPresenter
                                                    x:Name="PART_SelectedContentHost"
                                                    Grid.Column="1"
                                                    Margin="16,0,0,0"
                                                    ContentSource="SelectedContent"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"
                                                    KeyboardNavigation.TabIndex="2"
                                                    KeyboardNavigation.TabNavigation="Local" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <Style BasedOn="{StaticResource {x:Type TabItem}}" TargetType="TabItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TabItem">
                                            <Grid Margin="0,2">
                                                <Border
                                                    x:Name="Border"
                                                    MinHeight="40"
                                                    Padding="10,8"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="4">
                                                    <ContentPresenter
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Center"
                                                        ContentSource="Header"
                                                        RecognizesAccessKey="True" />
                                                </Border>
                                                <Rectangle
                                                    x:Name="ActiveRectangle"
                                                    Width="3"
                                                    Margin="0,8"
                                                    HorizontalAlignment="Left"
                                                    Fill="{DynamicResource TreeViewItemSelectionIndicatorForeground}"
                                                    RadiusX="2"
                                                    RadiusY="2"
                                                    Visibility="Collapsed" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="{ui:ThemeResource SubtleFillColorSecondaryBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource TabViewItemHeaderBackgroundSelected}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TabViewItemForegroundSelected}" />
                                                    <Setter TargetName="ActiveRectangle" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="Border" Property="Opacity" Value="0.5" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <Style BasedOn="{StaticResource {x:Type Label}}" TargetType="Label">
                                <Setter Property="Padding" Value="4,8" />
                            </Style>
                            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{StaticResource TextFillColorDisabled}" />
                        </pt:PropertyGrid.Resources>
                    </pt:PropertyGrid>
                </TabItem>
                <TabItem Header="{x:Static properties:Resources.PluginStore}">
                    <pluginStore:PluginStoreView DataContext="{Binding PluginStore}" />
                </TabItem>
                <TabItem Header="{x:Static properties:Resources.About}" Visibility="{Binding IsVisibleAbout, Converter={StaticResource b2vConv}}">
                    <DockPanel>
                        <ui:Button
                            Command="{Binding OpenReviewCommand}"
                            Content="{x:Static properties:Resources.WriteReview}"
                            DockPanel.Dock="Bottom"
                            Icon="{ui:SymbolIcon Star24}"
                            Margin="8"
                            Visibility="{Binding IsVisibleReviewButton, Converter={StaticResource b2vConv}}" />
                        <pt:PropertyGrid
                            Grid.Column="2"
                            Margin="8"
                            ControlFactory="{StaticResource factory}"
                            Operator="{StaticResource operator}"
                            SelectedObject="{x:Static root:AppInfo.Instance}"
                            TabVisibility="Collapsed">
                            <pt:PropertyGrid.Resources>
                                <Style BasedOn="{StaticResource {x:Type Label}}" TargetType="Label">
                                    <Setter Property="Padding" Value="4,8" />
                                </Style>
                                <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{StaticResource TextFillColorDisabled}" />
                            </pt:PropertyGrid.Resources>
                        </pt:PropertyGrid>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </DockPanel>
        <ContentPresenter x:Name="RootContentDialog" />
    </Grid>
</ui:FluentWindow>
