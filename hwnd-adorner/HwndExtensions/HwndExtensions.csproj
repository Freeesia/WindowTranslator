<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <Platforms>x64;ARM64</Platforms>
    <PlatformTarget Condition="'$(Platform)' == 'ARM64'">ARM64</PlatformTarget>
    <PlatformTarget Condition="'$(Platform)' != 'ARM64'">x64</PlatformTarget>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" />
    <PackageReference Include="Microsoft.Windows.CsWin32">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.Interactive" />
  </ItemGroup>
  <Target Name="ValidatePlatformTarget" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Platform)' != '' and '$(Platform)' != 'AnyCPU' and '$(Platform)' != 'x64' and '$(Platform)' != 'ARM64'"
           Text="HwndExtensions supports only x64 and ARM64." />
    <Error Condition="'$(PlatformTarget)' != 'x64' and '$(PlatformTarget)' != 'ARM64'"
           Text="HwndExtensions supports only x64 and ARM64." />
  </Target>
</Project>
