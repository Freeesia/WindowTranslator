<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>Sarashina3 Translator Plugin</Title>
    <Description>Translation for WindowTranslator using the Sarashina3 translate API.</Description>
    <IsPackable>true</IsPackable>
    <PackageTags>$(PackageTags);translate</PackageTags>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="WindowTranslator.Tests" />
  </ItemGroup>
</Project>
