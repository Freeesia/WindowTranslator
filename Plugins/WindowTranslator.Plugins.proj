<Project>
  <ItemGroup>
    <PluginProject
      Include="$(MSBuildThisFileDirectory)WindowTranslator.Plugin.*\*.csproj"
      Exclude="$(MSBuildThisFileDirectory)WindowTranslator.Plugin.*.Tests\*.csproj" />
  </ItemGroup>

  <Target Name="RestorePlugins">
    <MSBuild
      Projects="@(PluginProject)"
      Targets="Restore"
      BuildInParallel="true" />
  </Target>

  <Target Name="PackPlugins" DependsOnTargets="RestorePlugins">
    <MSBuild
      Projects="@(PluginProject)"
      Targets="Pack"
      BuildInParallel="true" />
  </Target>

  <Target Name="PublishAppBundle" DependsOnTargets="RestorePlugins">
    <MSBuild
      Projects="@(PluginProject)"
      Targets="Publish"
      BuildInParallel="true" />
  </Target>
</Project>
